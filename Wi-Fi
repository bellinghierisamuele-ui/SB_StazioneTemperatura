#include <WiFi.h>

// ==========================================
// CONFIGURAZIONE RETE WI-FI
// ==========================================
const char* ssid     = "NOME_DELLA_TUA_RETE";
const char* password = "PASSWORD_DELLA_RETE";

// Pin del LED (GPIO 2 è solitamente il LED integrato nella maggior parte dei moduli ESP32)
const int LED_PIN = 2;

// ==========================================
// CONFIGURAZIONE STATO LED
// Se vuoi il LED ACCESO quando c'è il Wi-Fi e SPENTO quando non c'è:
//   LED_STATO_CONNESSO    = HIGH
//   LED_STATO_DISCONNESSO = LOW
//
// Se invece vuoi il LED SPENTO quando c'è il Wi-Fi e ACCESO quando non c'è:
//   LED_STATO_CONNESSO    = LOW
//   LED_STATO_DISCONNESSO = HIGH
// ==========================================
const int LED_STATO_CONNESSO    = HIGH; // Stato del LED quando il Wi-Fi è CONNESSO
const int LED_STATO_DISCONNESSO = LOW;  // Stato del LED quando il Wi-Fi NON è connesso

void setup() {
  Serial.begin(115200);
  
  // Imposta il pin del LED come uscita
  pinMode(LED_PIN, OUTPUT);
  
  // Stato iniziale: Wi-Fi non ancora connesso
  digitalWrite(LED_PIN, LED_STATO_DISCONNESSO);

  // Avvio della connessione Wi-Fi
  Serial.print("Connessione in corso a ");
  Serial.println(ssid);
  WiFi.begin(ssid, password);
}

void loop() {
  // Verifichiamo lo stato della connessione
  if (WiFi.status() == WL_CONNECTED) {
    // --- WI-FI PRESENTE ---
    digitalWrite(LED_PIN, LED_STATO_CONNESSO);
    
    // Stampa di controllo sul Monitor Seriale (una sola volta all'avvenuta connessione)
    static bool giaStampato = false;
    if (!giaStampato) {
      Serial.println("\n[OK] Wi-Fi Connesso!");
      Serial.print("Indirizzo IP: ");
      Serial.println(WiFi.localIP());
      giaStampato = true;
    }
  } else {
    // --- WI-FI ASSENTE / DISCONNESSO ---
    digitalWrite(LED_PIN, LED_STATO_DISCONNESSO);
    
    Serial.println("[!] Wi-Fi non connesso, tentativo di riconnessione...");
    WiFi.reconnect(); // Riprova la connessione
    delay(2000);      // Attendi 2 secondi prima del controllo successivo
  }

  delay(500); // Ritardo per evitare di appesantire la CPU
}
